# Browser URL: http://localhost:8080  (same Wi‑Fi se dusre device: http://YOUR-PC-IP:8080)
PORT=8080
# Sab network interfaces par suno — taaki dusre PC/phone ke browser se bhi open ho
HOST=0.0.0.0

# Must match server/.env PORT (default 8081) — API proxy in package.json uses same port
REACT_APP_SOCKET_URL=http://localhost:8081

REACT_APP_API_URL=/api
