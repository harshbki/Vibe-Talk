# Browser URL: http://localhost:8080  (same Wi‑Fi se dusre device: http://YOUR-PC-IP:8080)
PORT=8080
# Sab network interfaces par suno — taaki dusre PC/phone ke browser se bhi open ho
HOST=0.0.0.0

# Must match server/.env PORT (default 8081) — API proxy in package.json uses same port
REACT_APP_SOCKET_URL=http://localhost:8081

REACT_APP_API_URL=/api

# Optional: AdSense slot IDs (production deploy)
# REACT_APP_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxx
# REACT_APP_ADSENSE_SLOT_RANDOM_MATCH_INLINE=xxxxxxxx
# REACT_APP_ADSENSE_SLOT_CHAT_SIDEBAR=xxxxxxxx
# REACT_APP_ADSENSE_SLOT_USERS_LIST_BOTTOM=xxxxxxxx
# REACT_APP_ADSENSE_SLOT_GROUP_CHAT_TOP=xxxxxxxx
# REACT_APP_ADSENSE_SLOT_PROFILE_BOTTOM=xxxxxxxx
# REACT_APP_MONETAG_ZONE_ID=your-zone-id
# REACT_APP_MONETAG_POPUNDER_URL=
