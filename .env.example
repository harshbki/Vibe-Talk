# --- Ports (all three must be free / allowed in firewall) ---
# | Service        | Port  | Where it is set                          |
# |----------------|-------|------------------------------------------|
# | React client   | 8080  | client/.env → PORT                       |
# | Node API+Socket| 8081  | server/.env → PORT (below)               |
# | MongoDB        | 27017 | MONGO_URI host port (default local)      |
# Firewall (Admin): .\scripts\open-dev-ports.ps1
# Browser mein tabs: npm run open-browser   ya   .\scripts\open-browsers.ps1
# Note: 27017 MongoDB hai — browser mein page nahi khulta, sirf DB port.

# Server environment
PORT=8081
HOST=0.0.0.0
CLIENT_URL=http://localhost:8080
# Local MongoDB only — no cloud/Atlas. Start MongoDB first (Windows: MongoDB service = Running).
# Default local DB on port 27017 — start with: npm run mongo (Docker) ya npm run mongo:win
MONGO_URI=mongodb://127.0.0.1:27017/vibetalk
JWT_SECRET=replace_with_a_long_random_secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Client environment (set at BUILD time on DigitalOcean — also copy to client/.env locally)
REACT_APP_API_URL=/api
REACT_APP_SOCKET_URL=http://localhost:8081
REACT_APP_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
REACT_APP_ADSENSE_SLOT_CHAT_SIDEBAR=1234567890
REACT_APP_ADSENSE_SLOT_USERS_LIST_BOTTOM=1234567890
REACT_APP_ADSENSE_SLOT_GROUP_CHAT_TOP=1234567890
REACT_APP_ADSENSE_SLOT_PROFILE_BOTTOM=1234567890
REACT_APP_ADSENSE_SLOT_RANDOM_MATCH_INLINE=1234567890
REACT_APP_MONETAG_ZONE_ID=your_monetag_zone_id