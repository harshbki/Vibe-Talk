{
  "name": "vibetalk",
  "version": "1.0.0",
  "description": "VibeTalk - Real-time anonymous chat and dating app",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "cd server && npm run dev",
    "client": "cd client && npm start",
    "build": "cd client && npm install && CI=false npm run build && test -f build/index.html",
    "install-all": "cd server && npm install && cd ../client && npm install",
    "dev": "cd server && npm run dev",
    "dev:all": "concurrently -n server,client -c blue,magenta \"npm run dev --prefix server\" \"npm run start --prefix client\"",
    "open-browser": "powershell -ExecutionPolicy Bypass -File scripts/open-browsers.ps1",
    "mongo": "docker compose up -d",
    "mongo:stop": "docker compose down",
    "mongo:win": "powershell -ExecutionPolicy Bypass -File scripts/start-mongodb.ps1",
    "check-local": "bash scripts/check-local.sh",
    "test-mongo": "bash scripts/test-mongo-uri.sh",
    "fix-client": "bash scripts/fix-client-deps.sh",
    "start-dev": "bash scripts/start-dev.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshbki/Vibe-Talk.git"
  },
  "keywords": [
    "chat",
    "dating",
    "mern",
    "socket.io",
    "webrtc"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/harshbki/Vibe-Talk/issues"
  },
  "homepage": "https://github.com/harshbki/Vibe-Talk#readme",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "babel-loader": "^10.1.1",
    "concurrently": "^9.2.1",
    "webpack-cli": "^6.0.1"
  }
}
